<!-- cm_01_hydro_v1.xml
     Current Measures v1: Pakistan hydro fixedOutput.
     Same 2025 calibration as v0, but increased 2035+ to reflect
     major planned projects (Diamer-Basha ~4.5 GW, Dasu ~4.3 GW).
     v0 had a uniform ~0.0063 EJ/5yr ramp; v1 accelerates post-2030.
     Target: ~194 PJ (0.194 EJ) by 2050 to match planned capacity.
     SAFE: fixedOutput is exogenous — no model coupling risk.
-->
<scenario>
  <world>
    <region name="Pakistan">
      <supplysector name="electricity" nocreate="1">
        <subsector name="hydro" nocreate="1">
          <stub-technology name="hydro" nocreate="1">
            <period year="2025">
              <fixedOutput>0.143679</fixedOutput>
            </period>
            <period year="2030">
              <fixedOutput>0.155000</fixedOutput>
            </period>
            <period year="2035">
              <fixedOutput>0.175000</fixedOutput>
            </period>
            <period year="2040">
              <fixedOutput>0.190000</fixedOutput>
            </period>
            <period year="2045">
              <fixedOutput>0.194000</fixedOutput>
            </period>
            <period year="2050">
              <fixedOutput>0.194000</fixedOutput>
            </period>
            <period year="2055">
              <fixedOutput>0.197000</fixedOutput>
            </period>
            <period year="2060">
              <fixedOutput>0.200000</fixedOutput>
            </period>
            <period year="2065">
              <fixedOutput>0.203000</fixedOutput>
            </period>
            <period year="2070">
              <fixedOutput>0.206000</fixedOutput>
            </period>
            <period year="2075">
              <fixedOutput>0.209000</fixedOutput>
            </period>
            <period year="2080">
              <fixedOutput>0.212000</fixedOutput>
            </period>
            <period year="2085">
              <fixedOutput>0.215000</fixedOutput>
            </period>
            <period year="2090">
              <fixedOutput>0.218000</fixedOutput>
            </period>
            <period year="2095">
              <fixedOutput>0.221000</fixedOutput>
            </period>
            <period year="2100">
              <fixedOutput>0.224000</fixedOutput>
            </period>
          </stub-technology>
        </subsector>
      </supplysector>
    </region>
  </world>
</scenario>
