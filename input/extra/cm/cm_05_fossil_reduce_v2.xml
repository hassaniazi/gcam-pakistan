<!-- cm_05_fossil_reduce_v2.xml
     Current Measures v2: Pakistan fossil fuel share-weight alignment.

     v1 produced (PJ at 2050): Coal 479, Gas 548. MSG: Coal 1056, Gas 1116.
     Gap: GCAM coal is 2.2x below MSG, gas is 2.0x below.

     v2 raises fossil share-weights further to reflect:
       - Coal: CPEC committed plants (Sahiwal 1.3 GW, Port Qasim 1.3 GW,
         Hub 1.3 GW, Thar-I/II ~1.3 GW, Engro Thar 0.66 GW). Total
         committed/operating ~5-6 GW. Pakistan Thar coal reserves are
         vast (175 Gt); current policy favors domestic coal over imports.
       - Gas: 15 GW installed CCGT/OCGT fleet. Two LNG terminals operational
         (EETPL 600 mmcfd, PGPL 750 mmcfd). Third terminal planned.
         Gas remains primary bridge fuel per NPCC/IGCEP.
       - Oil: Existing dual-fuel capacity (~4 GW RFO) being retired but slowly.

     v2 targets (PJ at 2050):
       Coal: ~700-800 (midpoint between v1=479 and MSG=1056)
       Gas:  ~750-850 (midpoint between v1=548 and MSG=1116)
       Oil:  ~150-200 (keep modest)

     Mechanism: Higher starting SW + gentler decline.
-->
<scenario>
  <world>
    <region name="Pakistan">
      <supplysector name="electricity" nocreate="1">
        <!-- COAL: v1 0.50→0.35; v2 0.70→0.55 -->
        <subsector name="coal" nocreate="1">
          <share-weight year="2025">0.70</share-weight>
          <share-weight year="2030">0.68</share-weight>
          <share-weight year="2035">0.65</share-weight>
          <share-weight year="2040">0.62</share-weight>
          <share-weight year="2045">0.58</share-weight>
          <share-weight fillout="1" year="2050">0.55</share-weight>
        </subsector>
        <!-- GAS: v1 0.65→0.45; v2 0.80→0.60 (bridge fuel emphasis) -->
        <subsector name="gas" nocreate="1">
          <share-weight year="2025">0.80</share-weight>
          <share-weight year="2030">0.78</share-weight>
          <share-weight year="2035">0.75</share-weight>
          <share-weight year="2040">0.70</share-weight>
          <share-weight year="2045">0.65</share-weight>
          <share-weight fillout="1" year="2050">0.60</share-weight>
        </subsector>
        <!-- REFINED LIQUIDS: v1 0.06→0.03; v2 0.08→0.04 -->
        <subsector name="refined liquids" nocreate="1">
          <share-weight year="2025">0.08</share-weight>
          <share-weight year="2030">0.07</share-weight>
          <share-weight year="2035">0.06</share-weight>
          <share-weight year="2040">0.05</share-weight>
          <share-weight year="2045">0.04</share-weight>
          <share-weight fillout="1" year="2050">0.04</share-weight>
        </subsector>
      </supplysector>
    </region>
  </world>
</scenario>
