<?xml version="1.0" encoding="UTF-8"?>
<!-- pak_co2luc_ffict.xml
     FFICT (Fossil Fuel and Industrial Carbon Trading) for Pakistan.
     Decouples land-use/agriculture CO2 from the carbon price and constraint.

     price-adjust=0.0:  AFOLU sectors do NOT face the carbon price.
     demand-adjust=0.0: AFOLU CO2 does NOT count toward constraint.
     Result: constraint applies to energy + industrial CO2 ONLY.

     WARNING: Must be loaded AFTER the ghgpolicy CO2 constraint XML.
     Pattern: matches global_ffict.xml but Pakistan-only.
-->
<scenario>
    <world>
        <region name="Pakistan">
            <linked-ghg-policy name="CO2_LUC">
                <market>Pakistan</market>
                <linked-policy>CO2</linked-policy>
                <price-adjust year="1975" fillout="1">0.0</price-adjust>
                <demand-adjust year="1975" fillout="1">0.0</demand-adjust>
                <price-unit>1990$/tC</price-unit>
                <output-unit>MTC</output-unit>
            </linked-ghg-policy>
        </region>
    </world>
</scenario>
