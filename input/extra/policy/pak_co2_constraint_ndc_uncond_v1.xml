<!-- pak_co2_constraint_ndc_uncond_v1.xml
     NDC Unconditional emissions constraint for Pakistan.
     Generated from CM v1 (CurrentMeasuresRev) output on 2026-04-17.
     Units: MTC (million tonnes carbon). Conversion: Mt CO2 * 12/44 = MTC.

     CM v1 E&IP (Mt CO2): 2025=241.26, 2030=288.99, 2035=343.39
     Formula:
       2030: 0.85 x 288.99 x 12/44 = 66.994 MTC
       2035+: 0.83 x 343.39 x 12/44 = 77.730 MTC
-->
<scenario>
    <world>
        <region name="Pakistan">
            <ghgpolicy name="CO2">
                <market>Pakistan</market>
                <constraint year="2030">66.994</constraint>
                <constraint year="2035">77.730</constraint>
                <constraint year="2040">77.730</constraint>
                <constraint year="2045">77.730</constraint>
                <constraint year="2050">77.730</constraint>
                <constraint year="2055">77.730</constraint>
                <constraint year="2060">77.730</constraint>
                <constraint year="2065">77.730</constraint>
