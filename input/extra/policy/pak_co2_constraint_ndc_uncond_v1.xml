<!-- pak_co2_constraint_ndc_uncond_v1.xml
     NDC Unconditional emissions constraint for Pakistan.
     Generated from CM v1 (CurrentMeasuresRev) output on 2026-04-23.
     Units: MTC (million tonnes carbon). Conversion: Mt CO2 * 12/44 = MTC.

     CM v1 E&IP (Mt CO2): 2025=237.85, 2030=276.20, 2035=323.67
     Formula:
       2030: 0.85 x 276.20 x 12/44 = 64.029 MTC
       2035+: 0.83 x 323.67 x 12/44 = 73.268 MTC
-->
<scenario>
    <world>
        <region name="Pakistan">
            <ghgpolicy name="CO2">
                <market>Pakistan</market>
                <constraint year="2030">64.029</constraint>
                <constraint year="2035">73.268</constraint>
                <constraint year="2040">73.268</constraint>
                <constraint year="2045">73.268</constraint>
                <constraint year="2050">73.268</constraint>
                <constraint year="2055">73.268</constraint>
                <constraint year="2060">73.268</constraint>
                <constraint year="2065">73.268</constraint>
                <constraint year="2070">73.268</constraint>
                <constraint year="2075">73.268</constraint>
                <constraint year="2080">73.268</constraint>
