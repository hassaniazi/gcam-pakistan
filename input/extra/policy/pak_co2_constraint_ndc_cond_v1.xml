<!-- pak_co2_constraint_ndc_cond_v1.xml
     NDC Conditional emissions constraint for Pakistan.
     Generated from CM v1 (CurrentMeasuresRev) output on 2026-04-23.
     Units: MTC (million tonnes carbon). Conversion: Mt CO2 * 12/44 = MTC.

     CM v1 E&IP (Mt CO2): 2025=237.85, 2030=276.20, 2035=323.67
     Formula:
       2030: 0.50 x 276.20 x 12/44 = 37.664 MTC
       2035+: 0.50 x 323.67 x 12/44 = 44.137 MTC
-->
<scenario>
    <world>
        <region name="Pakistan">
            <ghgpolicy name="CO2">
                <market>Pakistan</market>
                <constraint year="2030">37.664</constraint>
                <constraint year="2035">44.137</constraint>
                <constraint year="2040">44.137</constraint>
                <constraint year="2045">44.137</constraint>
                <constraint year="2050">44.137</constraint>
                <constraint year="2055">44.137</constraint>
                <constraint year="2060">44.137</constraint>
                <constraint year="2065">44.137</constraint>
                <constraint year="2070">44.137</constraint>
                <constraint year="2075">44.137</constraint>
                <constraint year="2080">44.137</constraint>
                <constraint year="2085">44.137</constraint>
                <constraint year="2090">44.137</constraint>
                <constraint year="2095">44.137</constraint>
                <constraint year="2100">44.137</constraint>
            </ghgpolicy>
        </region>
    </world>
</scenario>

